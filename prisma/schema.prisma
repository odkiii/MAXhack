generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  MODERATOR
  ADMIN
}

enum TeacherVerificationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  AWAITING_CLARIFICATION
  SCHEDULED
  CLOSED
  CANCELLED
}

enum TicketCategory {
  LAB
  PROJECT
  ACCESS
  GRADING
  RETAKE
  OTHER
}

enum CloseOutcome {
  RESOLVED
  REDIRECTED
  REJECTED
  CONSULTATION_SCHEDULED
}

enum TicketFeedback {
  HELPFUL
  NOT_HELPFUL
}

enum ClarificationType {
  REPO_LINK
  GROUP_NUMBER
  ERROR_SCREENSHOT
  LESSON_TOPIC
}

enum TicketEventType {
  CREATED
  ACCEPTED
  CLARIFICATION_REQUESTED
  CLARIFICATION_ANSWERED
  TEACHER_REPLIED
  SLOTS_PROPOSED
  SLOT_SELECTED
  CLOSED
  FEEDBACK_LEFT
  REASSIGNED
}

model User {
  id          String   @id @default(cuid())
  maxUserId   String   @unique
  displayName String?
  role        Role     @default(STUDENT)
  teacherVerificationStatus      TeacherVerificationStatus @default(NONE)
  teacherVerificationRequestedAt DateTime?
  teacherVerificationApprovedAt  DateTime?
  roleSelectedAt                 DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  consent          Consent?
  userState        UserState?
  ticketsAsStudent Ticket[]       @relation("StudentTickets")
  ticketsAsTeacher Ticket[]       @relation("TeacherTickets")
  ticketEvents     TicketEvent[]  @relation("ActorEvents")
}

model Consent {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentsVersion String
  acceptedAt       DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserState {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state     String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String         @id @default(cuid())
  ticketNumber Int            @unique @default(autoincrement())
  studentId    String
  student      User           @relation("StudentTickets", fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      User?          @relation("TeacherTickets", fields: [teacherId], references: [id], onDelete: SetNull)
  category     TicketCategory
  status       TicketStatus   @default(NEW)
  description  String

  clarificationTypes       ClarificationType[] @default([])
  clarificationComment     String?
  clarificationAnswer      String?
  clarificationAttachment  Json?
  teacherResponse       String?
  proposedSlots         Json?
  selectedSlot          String?

  closeOutcome CloseOutcome?
  closeReason  String?
  feedback     TicketFeedback?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events TicketEvent[]
}

model TicketEvent {
  id        String          @id @default(cuid())
  ticketId  String
  ticket    Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?           @relation("ActorEvents", fields: [actorId], references: [id], onDelete: SetNull)
  type      TicketEventType
  payload   Json            @default("{}")
  createdAt DateTime        @default(now())
}
